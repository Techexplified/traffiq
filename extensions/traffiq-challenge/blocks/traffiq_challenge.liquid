{% comment %}
  Traffiq Bot Challenge Protection - Theme App Embed
  Intercepts Add to Cart and Checkout when Protection Mode is set to CHALLENGE
{% endcomment %}

{% assign current_backend_url = "https://traffiq-smoky.vercel.app" %}
{% assign app_endpoint = block.settings.app_url %}
{% if app_endpoint == blank or app_endpoint contains "trycloudflare.com" %}
  {% assign app_endpoint = current_backend_url %}
{% endif %}

<script>
  window.TRAFFIQ_CONFIG = window.TRAFFIQ_CONFIG || {};
  window.TRAFFIQ_CONFIG.shopDomain = {{ shop.permanent_domain | json }};
  window.TRAFFIQ_CONFIG.appUrl = {{ app_endpoint | json }};
</script>

{% schema %}
{
  "name": "Traffiq Bot Challenge",
  "target": "body",
  "javascript": "traffiq-challenge.js",
  "stylesheet": "traffiq-challenge.css",
  "settings": [
    {
      "type": "text",
      "id": "app_url",
      "label": "Traffiq App Endpoint",
      "default": "https://traffiq-smoky.vercel.app",
      "info": "The public URL of your Traffiq app backend"
    }
  ]
}
{% endschema %}
